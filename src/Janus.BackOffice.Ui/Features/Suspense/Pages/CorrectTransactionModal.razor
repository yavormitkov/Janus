@using Janus.Core.Shared.DTOs

@if (IsOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title fw-bold">Propose Transaction Correction</h5>
                    <button type="button" class="btn-close" @onclick="Cancel"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3 bg-light p-3 rounded border">
                        <div class="row g-2">
                            <div class="col-6"><span class="text-muted d-block small">Reference:</span> <strong>@Transaction.ReferenceNumber</strong></div>
                            <div class="col-6"><span class="text-muted d-block small">File Ref:</span> <strong>@Transaction.FileReference</strong></div>
                            <div class="col-12"><span class="text-muted d-block small">Inbound Name:</span> <strong>@Transaction.InboundClientName</strong></div>
                            <div class="col-12"><span class="text-muted d-block small">Inbound EGN:</span> <code class="fw-bold">@Transaction.InboundEGN</code></div>
                            <div class="col-12"><span class="text-muted d-block small">Amount:</span> <strong class="text-success">€@Transaction.Amount.ToString("N2")</strong></div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label fw-semibold">Target Client Identifier (@_expectedEgnLength digits):</label>
                        <input type="text" class="form-control form-control-lg font-monospace" @bind="_correctedEgn" maxlength="@_expectedEgnLength" placeholder="@(new string('0', _expectedEgnLength))" />

                        @if (!string.IsNullOrEmpty(_errorMessage))
                        {
                            <div class="text-danger small mt-1 fw-medium">⚠️ @_errorMessage</div>
                        }
                    </div>
                </div>
                <div class="modal-footer bg-light border-top-0">
                    <button type="button" class="btn btn-secondary" @onclick="Cancel">Cancel</button>
                    <button type="button" class="btn btn-warning fw-bold px-4" @onclick="Submit">Submit Proposal</button>
                </div>
            </div>
        </div>
    </div>
}
