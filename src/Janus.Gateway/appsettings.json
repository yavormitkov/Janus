{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "IdentitySimulation": {
    "Maker": {
      "UserId": "BBBBBBBB-1111-2222-3333-444444444444",
      "UserRole": "Maker"
    },
    "Checker": {
      "UserId": "CCCCCCCC-5555-6666-7777-888888888888",
      "UserRole": "Checker"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "api-route": {
        "ClusterId": "ledger-api-cluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        },
        "CorsPolicy": "BlazorWasmCorsPolicy"
      }
    },
    "Clusters": {
      "ledger-api-cluster": {
        "Destinations": {
          "protected-api": {
            "Address": "http://localhost:5031"
          }
        }
      }
    }
  }
}
