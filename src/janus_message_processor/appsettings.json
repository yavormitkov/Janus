{
  "ConnectionStrings": {
    "JanusFinancialDb": "Server=localhost,1433;Database=JanusFinancialDb;User Id=sa;Password=%DB_PASSWORD%;TrustServerCertificate=True;"
  },
  "OutboxPolicy": {
    "PollingIntervalMilliseconds": 10000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Heading": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Resilience": {
    "PipelineName": "DBRetryPipeline",
    "MaxRetryAttempts": 3,
    "DelaySeconds": 2,
    "UseJitter": true
  }
}
